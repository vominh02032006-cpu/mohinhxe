{
  "services": {
    "frontend": {
      "root": ".",
      "framework": "angular",
      "buildCommand": "npm run build",
      "outputDirectory": "dist/bhshop/browser"
    },
    "backend": {
      "root": "backend/",
      "framework": "express",
      "entrypoint": "src/server.js",
      "functions": {
        "src/server.js": {
          "includeFiles": "data/*.json"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
